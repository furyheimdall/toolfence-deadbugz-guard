{
  "mcpServers": {
    "filesystem": {
      "command": "deadbugz-guard",
      "args": [
        "--pin", "/absolute/path/to/deadbugz/pin-filesystem.json",
        "--audit", "/absolute/path/to/deadbugz/audit.jsonl",
        "--hitl", "http://127.0.0.1:8765",
        "--call-gate", "3",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/absolute/path/to/allowed/directory"
      ],
      "env": {
        "PIN_PATH": "/absolute/path/to/deadbugz/pin-filesystem.json",
        "AUDIT_PATH": "/absolute/path/to/deadbugz/audit.jsonl",
        "HITL_ENDPOINT": "http://127.0.0.1:8765",
        "CALL_GATE": "3"
      }
    },
    "fetch": {
      "command": "deadbugz-guard",
      "args": [
        "--pin", "/absolute/path/to/deadbugz/pin-fetch.json",
        "--audit", "/absolute/path/to/deadbugz/audit.jsonl",
        "--hitl", "http://127.0.0.1:8765",
        "--call-gate", "3",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "env": {
        "PIN_PATH": "/absolute/path/to/deadbugz/pin-fetch.json",
        "AUDIT_PATH": "/absolute/path/to/deadbugz/audit.jsonl",
        "HITL_ENDPOINT": "http://127.0.0.1:8765",
        "CALL_GATE": "3"
      }
    }
  }
}
