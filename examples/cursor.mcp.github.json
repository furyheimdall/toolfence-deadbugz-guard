{
  "mcpServers": {
    "github": {
      "command": "/ABS/bin/deadbugz-guard",
      "args": [
        "--name", "github",
        "--pin", "~/.deadbugz/pins/github.json",
        "--audit", "~/.deadbugz/audit/github.jsonl",
        "--call-gate", "3",
        "--",
        "/ABS/github-mcp-server",
        "--toolsets", "repos,issues"
      ],
      "env": {
        "DEADBUGZ_SERVER_NAME": "github",
        "GITHUB_TOOLSETS": "repos,issues"
      }
    }
  }
}
