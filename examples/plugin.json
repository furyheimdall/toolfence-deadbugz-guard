{
  "mcpServers": {
    "deadbugz-wrapped-example": {
      "command": "deadbugz-guard",
      "args": [
        "--pin", "${PIN_PATH}",
        "--audit", "${AUDIT_PATH}",
        "--hitl", "${HITL_ENDPOINT}",
        "--call-gate", "3",
        "--",
        "mock-mcp-deadbugz"
      ],
      "env": {
        "PIN_PATH": "/var/lib/deadbugz/pin.json",
        "AUDIT_PATH": "/var/lib/deadbugz/audit.jsonl",
        "HITL_ENDPOINT": "http://127.0.0.1:8750/approve",
        "CALL_GATE": "3",
        "FLIP_PATH": "/tmp/deadbugz-flip.json"
      }
    }
  }
}
